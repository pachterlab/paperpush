#!/usr/bin/env bash
#
# Pre-push guard: run the same "generated files are in sync" checks CI runs
# (.github/workflows/ci.yml), so a stale artifact blocks the push locally
# instead of failing CI on GitHub. The pre-commit hook regenerates most of
# these; this catches anything it missed (commits made with --no-verify,
# merges, rebases, commits made in another clone).
#
# Checks the working tree, so commit or stash unrelated edits first if they
# touch the venue data. Bypass for one push with  git push --no-verify.
#
set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 1

checks=(
    "scripts/gen_readme_venues.py"
    "scripts/gen_venues_schema.py"
    "scripts/gen_schema_docs.py"
    "scripts/gen_subfile_templates.py"
    "scripts/gen_validation_check_count.py"
    "scripts/gen_comparison_table.py"
)

failed=()
for script in "${checks[@]}"; do
    [ -f "$script" ] || continue
    if ! python "$script" --check >/dev/null 2>&1; then
        failed+=("$script")
    fi
done

if [ "${#failed[@]}" -gt 0 ]; then
    echo >&2
    echo "pre-push: generated files are out of date; CI would fail. Run:" >&2
    for script in "${failed[@]}"; do
        echo "    python $script" >&2
    done
    echo "then commit the regenerated files and push again" >&2
    echo "(or bypass with  git push --no-verify)." >&2
    exit 1
fi

exit 0
