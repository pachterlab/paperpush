# paperpush submission file for discrete_mathematics  -*- mode: yaml -*-
# Discrete Mathematics (Elsevier)
#
# Edit the values below, then run:  paperpush submit discrete_mathematics.sub
# Lines starting with '#' are comments and are ignored.

@venue: discrete_mathematics
# submission guide: https://www.sciencedirect.com/journal/discrete-mathematics/publish/guide-for-authors

# Article type (choice, REQUIRED)
#   The submission type chosen on the Elsevier portal's first step (a radio button). Pick the label that matches your submission; if the runner cannot match the label it leaves the portal's default selection.
#   options: Contribution | Note
article_type: Note

# Manuscript title (text, REQUIRED)
#   The full title of the manuscript, typed into the portal's 'Your title' box.
title: Title goes here

# Abstract (textarea, REQUIRED)
#   Plain-text abstract, typed into the portal's 'Your abstract' box.
abstract: |
  Abstract goes here. It's a really good abstract.

# Keywords (text, REQUIRED)
#   Semicolon-separated list of 1-7 keywords (e.g. 'graph theory;combinatorics'), typed into the portal's 'Your keywords' box.
keywords: graph theory;combinatorics;enumeration

# Authors (authorlist, REQUIRED)
#   One author per line, in order. Format: Name | email | institution | corresponding(yes/no). Write the name as 'First Last'; the portal's author form splits it into first/last name on the last space. The institution box is an autocomplete: type the affiliation and the runner takes the first suggestion. Mark exactly one author corresponding=yes.
authors: |
  Joseph Richie | jmrich@caltech.edu | California Institute of Technology | no
  Joseph Rich | jmrich@usc.edu | University of Southern California | yes

# Manuscript file (file, REQUIRED)
#   Path to the manuscript, uploaded as the 'Manuscript' required item on the portal's upload step.
manuscript_file: tests/manuscript_files/discrete_mathematics/manuscript.pdf

# Declaration of competing interests file (file, optional)
#   Optional. Path to a Declaration of competing interests document, uploaded as the 'Declaration of competing interests' item. Leave blank and set no_competing_interests to yes if there are no competing interests. See https://declarations.elsevier.com/home?journalAcronym=DISCM for the template.
declaration_file: tests/manuscript_files/discrete_mathematics/declaration_of_interest.pdf

# No competing interests to declare (boolean, optional)
#   Set to yes to tick the 'I confirm that no authors have competing interests' checkbox instead of uploading a declaration file. Ignored when declaration_file is provided.
no_competing_interests: 

# Figure files (filelist, optional)
#   Optional. One figure file per line as 'path | label' (label optional and unused at upload). Each is uploaded as a separate 'Figure' optional item.
figure_files: |
  tests/manuscript_files/discrete_mathematics/figures/fig1.pdf | Figure 1

# LaTeX source files (file, optional)
#   Optional. Path to the LaTeX source (a single .tex file or a .zip bundle of sources), uploaded as the 'LaTeX source files' optional item.
latex_source: 

# Supplementary material (filelist, optional)
#   Optional. One supplementary file per line as 'path | label' (label optional and unused at upload). Each is uploaded as a separate 'Supplementary material' optional item.
supplementary_files: |
  

# Share research data (boolean, optional)
#   Set to yes to answer 'Yes' on the portal's 'Do you want to share data?' step and link a dataset that is already deposited in a repository; the four fields below are then required and data_statement is ignored. Leave as no (the default) to decline, in which case the runner answers 'No' and picks data_statement from the dropdown. Depositing the data in the repository is not automated -- do that first, then give the link here.
share_data: yes

# Data repository (choice, optional)
#   Used only when share_data is yes. The repository holding the dataset. The options are the entries of the portal's 'Select a repository' dropdown, and the runner clicks the one matching this value; pick 'Other' for a repository the dropdown does not list.
#   options: figshare | caNanoLab | CCDC | Dataverse | Dryad | Earth/Chem | HepData | ICPSR | Mendeley Data | MGDS | ModelDB | NED | NURSA | ORNL-DAAC | PANGAEA | RunMyCode | Seanoe | SIMBAD | SOL Genomics | WHOAS | Other
data_repository_name: Other

# Data repository link (text, optional)
#   Used only when share_data is yes. The http(s) link to the deposited dataset, pasted into the portal's 'Paste your data repository link here' box.
#   each non-blank line must be a valid http/https URL
data_repository_url: https://zenodo.org/records/1234567

# Source of data (choice, optional)
#   Used only when share_data is yes. Ticks the portal's data-source radio: 'original' for data generated by this study, 'reference' for an existing dataset reused here.
#   options: original | reference
source_of_data: reference

# Dataset title (text, optional)
#   Used only when share_data is yes. The dataset's title as it appears in the repository, typed into the portal's 'Type your title here' box.
dataset_title: Reference graph collection reused in Title goes here

# Research data statement (choice, REQUIRED)
#   The research-data answer on the portal's 'Do you want to share data?' step, used when share_data is no (the default). The runner selects 'No' and picks this statement from the dropdown. The options below are the portal's own dropdown entries; they are recommended, not required -- any other wording is accepted (with a warning), and the runner then picks the dropdown's 'Other' entry and types your text into its free-text box. Keep a custom statement to 200 characters. Sharing data in a repository is not automated; do that step by hand if it applies.
#   at most 200 characters
#   options: No data was used for the research described in the article. | The data that has been used is confidential. | Data will be made available upon request. | The authors do not have permission to share data. | The authors are unable or have chosen not to specify which data has been used.
data_statement: No data was used for the research described in the article.

# Final submission declarations confirmed (boolean, REQUIRED)
#   Confirms the portal's final declarations (ethics-in-publishing policy, copyright terms, and that all sources/conflicts are mentioned). The runner ticks these boxes only when this is yes.
declarations_confirmed: yes

# vim: set filetype=yaml :
