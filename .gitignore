# Saved portal page captures (e.g. ScholarOne recordings). These carry
# per-session security tokens, so they must not be committed.
*_declarations.html

# Screenshot + HTML captures written by the portal-drift tests when a check
# fails (tests/test_portal_drift.py -> common.capture_failure). Diagnostic
# scratch that embeds per-session tokens; never commit it.
tests/portal_snapshots/_failures/
